# Application — required in production, server-only unless stated otherwise.
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Superadministración — server-only. Correos con autoridad máxima sobre la
# plataforma, separados por coma. Vacío significa que nadie entra al panel.
SUPERADMIN_EMAILS=aresiaagency@gmail.com

# Google OAuth — server-only. Configure the callback as:
# ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL source of truth — server-only.
DATABASE_URL=

# Redis for distributed rate limits, buffers and locks — server-only.
REDIS_URL=

# Signed n8n → BUROINSTANT webhook — server-only.
N8N_BASE_URL=
N8N_EVOLUTION_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Evolution API — server-only. Never expose through NEXT_PUBLIC_*.
EVOLUTION_MANAGER_URL=https://gestor-tramites-evolution-api.7dklrk.easypanel.host
EVOLUTION_API_BASE_URL=
EVOLUTION_API_INSTANCE=
EVOLUTION_API_KEY=

# Optional AI providers — server-only. The deterministic core works without them.
OPENAI_API_KEY=
# Modelo de transcripcion del canal de voz del Orbe. Vacio usa whisper-1.
# La clave se usa SOLO en el servidor: nunca con prefijo NEXT_PUBLIC_.
OPENAI_TRANSCRIBE_MODEL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Key material and scheduled jobs — server-only.
ENCRYPTION_KEY=
CRON_SECRET=

# Clave maestra del archivo de documentos. Cifra la clave de datos de cada
# archivo (AES-256-GCM). 32 bytes en hexadecimal (64 caracteres) o en base64:
#   openssl rand -hex 32
# Sin ella el archivo NO acepta documentos: antes que guardar un DNI en claro,
# no se guarda. Solo servidor: nunca con prefijo NEXT_PUBLIC_.
# Si se pierde, los documentos ya guardados no se pueden recuperar.
DOCUMENT_ENCRYPTION_KEY=

# Public official source base URL; not a secret.
AEAT_SOURCE_BASE_URL=https://sede.agenciatributaria.gob.es
