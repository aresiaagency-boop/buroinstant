{
  "name": "AVISOS_BUROINSTANT",
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "buroinstant-aviso",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "webhook-aviso",
      "name": "Aviso entrante",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ],
      "webhookId": "buroinstant-aviso",
      "credentials": {
        "httpHeaderAuth": {
          "name": "BUROINSTANT token de avisos"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "/**\n * Comprobacion del aviso.\n *\n * Quien llama lo comprueba n8n en el propio webhook, con una credencial de\n * cabecera: el secreto vive cifrado en n8n y este nodo no necesita leerlo.\n * Aqui se comprueba lo que se puede comprobar sin secreto, y se falla cerrado:\n * cualquier duda rechaza.\n */\nconst rechazar = (motivo) => [{ json: { valido: false, motivo } }];\ntry {\n  const entrada = $input.first().json || {};\n  const cab = entrada.headers || {};\n  const cuerpo = entrada.body;\n  if (!cuerpo || typeof cuerpo !== 'object') return rechazar('BODY_NOT_JSON');\n  const marca = cab['x-buroinstant-timestamp'];\n  if (!marca) return rechazar('MISSING_TIMESTAMP');\n  const t = Date.parse(marca);\n  if (!Number.isFinite(t)) return rechazar('BAD_TIMESTAMP');\n  // Cinco minutos: sin esto, quien capture una peticion valida puede repetirla.\n  if (Math.abs(Date.now() - t) > 300000) return rechazar('TIMESTAMP_OUT_OF_WINDOW');\n  if (cuerpo.source !== 'BUROINSTANT_DEADLINE_REMINDER') return rechazar('BAD_SOURCE');\n  const phone = String(cuerpo.phone == null ? '' : cuerpo.phone);\n  if (!/^[0-9]{7,20}$/.test(phone)) return rechazar('BAD_PHONE');\n  const text = String(cuerpo.text == null ? '' : cuerpo.text);\n  if (!text.trim() || text.length > 4000) return rechazar('BAD_TEXT');\n  const clave = String(cuerpo.idempotencyKey == null ? '' : cuerpo.idempotencyKey);\n  return [{ json: { valido: true, phone, text, idempotencyKey: clave } }];\n} catch (error) {\n  return rechazar('VERIFICATION_ERROR');\n}"
      },
      "id": "verificar-firma",
      "name": "Verificar aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "firma-valida",
              "leftValue": "={{ $json.valido }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "firma-valida",
      "name": "¿Aviso válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        80,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://gestor-tramites-evolution-api.7dklrk.easypanel.host/message/sendText/GESTOR_TRAMITES",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.phone, text: $json.text }) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "enviar-evolution",
      "name": "Enviar por Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        -100
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "name": "Evolution apikey avisos"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: ($json.statusCode >= 200 && $json.statusCode < 300), evolutionStatus: $json.statusCode }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "responder-ok",
      "name": "Responder 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        560,
        -100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: $json.motivo }) }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "responder-401",
      "name": "Responder 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        320,
        120
      ]
    }
  ],
  "connections": {
    "Aviso entrante": {
      "main": [
        [
          {
            "node": "Verificar aviso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verificar aviso": {
      "main": [
        [
          {
            "node": "¿Aviso válido?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Aviso válido?": {
      "main": [
        [
          {
            "node": "Enviar por Evolution",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Responder 401",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar por Evolution": {
      "main": [
        [
          {
            "node": "Responder 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
